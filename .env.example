# Supabase project shared by local and production when using one auth/data environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only administrative key. Never expose this to browser/client code.
SUPABASE_SECRET_KEY=your-secret-key
